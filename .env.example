# Copy to .env (git-ignored). Only EXPO_PUBLIC_* values are bundled into the app.
# RevenueCat -> Project -> API keys -> App Store app public key (starts with appl_).
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_replace_me
# Optional; only needed if an Android build is ever made.
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
# QA only. Set by the `testflight` EAS profile, never locally or in production.
# EXPO_PUBLIC_QA_BYPASS_PAYWALL=true
