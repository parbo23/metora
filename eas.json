{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "ios": {
        "image": "latest"
      }
    },
    "testflight": {
      "extends": "production",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_QA_BYPASS_PAYWALL": "true"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {}
    },
    "testflight": {
      "ios": {}
    }
  }
}
